# CacheCloud 部署配置。复制为仓库根目录的 .env 后修改，切勿提交。
#   cp deploy/.env.example .env && chmod 600 .env

# --- 镜像 ---------------------------------------------------------------
# 两个都必填（compose 里用 :? 强制），本地构建见 README「构建镜像」
CACHECLOUD_IMAGE=cachecloud:local
CACHECLOUD_FRONTEND_IMAGE=cachecloud-ui:local
# 可选：Docker Hub 不可用时可指定本机已有的 Redis 6.2.24 兼容镜像
# CACHECLOUD_REDIS_IMAGE=redis:6.2.24-alpine

# --- 对外端口 -----------------------------------------------------------
# 浏览器访问 FRONTEND_PORT；BACKEND_PORT 只为排障直连后端，可不对外开放
CACHECLOUD_FRONTEND_PORT=28082
CACHECLOUD_BACKEND_PORT=28083

# 后端据此拼接回调/跳转地址，必须是浏览器实际访问到的地址（含端口）
SERVER_DOMAIN=http://127.0.0.1:28082
# 登录会话有效期，默认 12 小时。
CACHECLOUD_AUTH_SESSION_TTL_SECONDS=43200

# --- 口令（务必替换）----------------------------------------------------
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password

# --- 数据库 -------------------------------------------------------------
# 改库名要同步四处，见 deploy/README.md「数据库名」
CACHECLOUD_DB_NAME=redis_manager

# --- MySQL 定时备份 -----------------------------------------------------
# 产物落在 deploy/mysql/backups/（宿主机目录，不随 docker volume 被清掉）
MYSQL_BACKUP_INTERVAL_SECONDS=21600
MYSQL_BACKUP_KEEP_DAYS=14
