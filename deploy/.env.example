CACHECLOUD_IMAGE=cachecloud:local
CACHECLOUD_PORT=28082
SERVER_DOMAIN=https://redis-portal.shcj-s.com.cn
MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password

# 数据库名（compose 的 mysql-backup 用它决定备份哪个库；
# 改这里的同时必须改 web 的 CACHECLOUD_PRIMARY_URL 与 deploy/mysql/init.sql）
CACHECLOUD_DB_NAME=redis_manager

# MySQL 定时备份：间隔秒数与保留天数
# 产物落在 deploy/mysql/backups/（宿主机目录，不随 docker volume 被清掉）
MYSQL_BACKUP_INTERVAL_SECONDS=21600
MYSQL_BACKUP_KEEP_DAYS=14
