# CacheCloud 非容器部署配置。
#   cp conf/cachecloud.env.example conf/cachecloud.env
#   chmod 600 conf/cachecloud.env
#   $EDITOR conf/cachecloud.env
#
# 改完先跑 bash scripts/preflight.sh 自检。

# --- 安装位置 -----------------------------------------------------------
CC_HOME=/opt/cachecloud
CC_USER=cachecloud
# 已有 Tomcat 就填它的路径；留空则用 $CC_HOME/tomcat，
# 由 install.sh 从 depsj/apache-tomcat-9*.tar.gz 解压
CC_TOMCAT_HOME=

# --- 端口 ---------------------------------------------------------------
# 浏览器访问这个；后端只监听 127.0.0.1，不对外
CC_HTTP_PORT=8080
CC_BACKEND_PORT=8081

# 浏览器实际访问到的地址，含端口。后端据此拼接跳转地址，填错会导致 403 跨域
CC_SERVER_DOMAIN=http://127.0.0.1:8080

# --- MySQL（需自行部署，5.7.44 已验证）---------------------------------
CC_MYSQL_HOST=127.0.0.1
CC_MYSQL_PORT=3306
CC_MYSQL_DB=redis_manager
CC_MYSQL_USER=root
CC_MYSQL_PASSWORD=replace-me

# --- 平台自用 Redis Sentinel（非被纳管对象）----------------------------
CC_REDIS_HOST=127.0.0.1
CC_REDIS_PORT=6379
CC_REDIS_PASSWORD=
# 配置以下两项后启用 Sentinel；节点以逗号分隔。留空则兼容直连模式。
CC_REDIS_SENTINEL_MASTER=cachecloud-master
CC_REDIS_SENTINEL_NODES=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
CC_REDIS_SENTINEL_PASSWORD=

# --- JVM ----------------------------------------------------------------
# 机器内存 8G 以下建议 Xmx 不超过物理内存的 1/4
CC_JAVA_XMS=512m
CC_JAVA_XMX=1536m

# --- 其它 ---------------------------------------------------------------
# online / local / test，见 application-*.yml
CC_PROFILE=online
CC_TIMEZONE=Asia/Shanghai
